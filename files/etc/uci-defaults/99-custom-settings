#!/bin/sh
#
# Default settings of the Xiaomi AX3200 / Redmi AX6S build.
#
# uci-defaults scripts run on the first boot after every flash, including a
# sysupgrade that keeps settings. These defaults are applied only once per
# configuration: a marker is stored in /etc/config/ax3200, which sysupgrade
# keeps together with the rest of /etc/config. This way user changes, e.g.
# disabling flow offloading in favour of SQM, survive firmware upgrades.
# Only the collectd include cleanup and the release name below run on every flash; the bridger
# and packet steering defaults have their own markers.
#
# Wi-Fi radio defaults are set by /etc/uci-defaults/77_wireless. The list of LuCI themes is
# brought in line with the installed ones on every boot by /etc/init.d/luci-themes.

# A LuCI theme is usable when its header template exists (the same check LuCI does)
theme_ok() {
	[ -f "/usr/share/ucode/luci/template/themes/${1##*/}/header.ut" ]
}

# collectd, on every flash: older builds included /etc/collectd/conf.d for the ethstat WAN
# graph, which the interface graphs make redundant now that the switch port counters include
# offloaded traffic. Drop that include once the directory is gone, so that the configuration
# does not keep pointing to nothing (collectd itself silently ignores a missing include).
if [ "$(uci -q get luci_statistics.collectd.Include)" = "/etc/collectd/conf.d" ] && \
   [ ! -d /etc/collectd/conf.d ]; then
	uci -q delete luci_statistics.collectd.Include
	uci -q commit luci_statistics
fi

# On every flash: name the release of this build after the OpenWrt version, e.g. in Status ->
# Overview -> Firmware Version (OPENWRT_RELEASE, which "ubus call system board" reports as the
# description). The release comes from /etc/ax3200_release; a local build has none.
. /etc/ax3200_release 2>/dev/null
if [ -n "${RELEASE:-}" ] && ! grep -q "^OPENWRT_RELEASE=.* ${RELEASE#v*-}\"$" /usr/lib/os-release; then
	sed -i "s/^OPENWRT_RELEASE=\"\(.*\)\"$/OPENWRT_RELEASE=\"\1 ${RELEASE#v*-}\"/" /usr/lib/os-release
fi

# bridger is installed but off by default, once per configuration (it came after the other defaults,
# hence its own marker). It forwards wired -> 5 GHz traffic in hardware, past the airtime scheduling and
# the queues of mac80211: much less CPU, but higher latency, and less fairness when several Wi-Fi clients
# are busy. The Maximum throughput operating mode enables it (LuCI: System -> Operating mode, or "tuning").
if [ -x /etc/init.d/bridger ] && [ "$(uci -q get ax3200.defaults.bridger)" != "1" ]; then
	/etc/init.d/bridger disable
	/etc/init.d/bridger stop 2>/dev/null
	touch /etc/config/ax3200
	uci set ax3200.defaults='defaults'
	uci set ax3200.defaults.bridger='1'
	uci -q commit ax3200
fi

# Packet steering mode 2 replaced mode 1 as the default with the operating modes. Configurations that still
# have the old default move to mode 2 once, so that they show the Balanced mode; with SQM on, mode 1 stays,
# as it suits SQM better. New configurations get mode 2 below.
if [ "$(uci -q get ax3200.defaults.steering)" != "1" ]; then
	if [ "$(uci -q get ax3200.defaults.applied)" = "1" ] && [ "$(uci -q get network.globals.packet_steering)" = "1" ] && \
	   ! uci -q show sqm | grep -q "\.enabled='1'$"; then
		uci set network.globals.packet_steering='2'
		uci -q commit network
	fi
	touch /etc/config/ax3200
	uci set ax3200.defaults='defaults'
	uci set ax3200.defaults.steering='1'
	uci -q commit ax3200
fi

# https-dns-proxy, once per configuration. While its backup of the dnsmasq server list was that of
# an empty list (a single empty entry), every start backed the list up again, with the proxy
# addresses and canary domains the service adds itself (fixed by the feed patch). Its stop restores
# the backup, so these entries stayed in dnsmasq: dead proxy addresses once DoH is off, and the canary
# domains, which keep iCloud Private Relay and the DoH of Firefox off although force_dns is off.
# Undo the service's changes as its stop does, without its own entries; its next start backs up the
# clean list. The service is not running yet.
if [ "$(uci -q get ax3200.defaults.doh_backup)" != "1" ]; then
	set -f
	# The proxy addresses as the service derives them: listen_addr, and listen_port or 5053 counting up
	doh_own='/mask.icloud.com/ /mask-h2.icloud.com/ /use-application-dns.net/'
	doh_port=5053
	for s in $(uci -q show https-dns-proxy | sed -n 's/^https-dns-proxy\.\([^.=]*\)=https-dns-proxy$/\1/p'); do
		a="$(uci -q get "https-dns-proxy.$s.listen_addr" || uci -q get https-dns-proxy.config.listen_addr || echo 127.0.0.1)"
		case "$a" in 0.0.0.0|::ffff:0.0.0.0) a=127.0.0.1 ;; ::) a=::1 ;; esac
		doh_own="$doh_own $a#$(uci -q get "https-dns-proxy.$s.listen_port" || echo "$doh_port")"
		doh_port=$((doh_port + 1))
	done
	for s in $(uci -q show dhcp | sed -n 's/^dhcp\.\([^.=]*\)=dnsmasq$/\1/p'); do
		own="$doh_own $(uci -q get "dhcp.$s.doh_server")"
		servers="$(uci -q get "dhcp.$s.server")"
		keep=
		for e in $servers $(uci -q get "dhcp.$s.doh_backup_server"); do
			case " $own $keep " in *" $e "*) ;; *) keep="$keep $e" ;; esac
		done
		if [ "${keep# }" = "$servers" ] && ! uci -q get "dhcp.$s.doh_backup_server" >/dev/null && \
		   ! uci -q get "dhcp.$s.doh_backup_noresolv" >/dev/null && ! uci -q get "dhcp.$s.doh_server" >/dev/null; then
			continue
		fi
		case "$(uci -q get "dhcp.$s.doh_backup_noresolv")" in
			'') ;;
			-1) uci -q delete "dhcp.$s.noresolv" ;;
			*) uci set "dhcp.$s.noresolv=$(uci -q get "dhcp.$s.doh_backup_noresolv")" ;;
		esac
		for o in doh_backup_noresolv doh_backup_server doh_server server; do
			uci -q delete "dhcp.$s.$o"
		done
		for e in $keep; do
			uci add_list "dhcp.$s.server=$e"
		done
	done
	set +f
	uci -q commit dhcp
	touch /etc/config/ax3200
	uci set ax3200.defaults='defaults'
	uci set ax3200.defaults.doh_backup='1'
	uci -q commit ax3200
fi

# Presets for automatic channel selection (effective only when the user picks channel "auto"):
# keep fixed channels and any user-configured ACS options untouched. On a fresh install,
# 77_wireless runs /sbin/wifi config before 99-custom-settings (after kmodloader), so radio0 and
# radio1 already exist; guard on '=wifi-device$' so an empty wireless file never sets the marker.
if [ -f /etc/config/wireless ] && uci -q show wireless | grep -q '=wifi-device$' && \
   [ "$(uci -q get ax3200.defaults.acs)" != "1" ]; then
	for sec in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
		band="$(uci -q get wireless."$sec".band)"
		if [ "$band" = "2g" ]; then
			[ -z "$(uci -q get wireless."$sec".channels)" ] && \
				uci add_list wireless."$sec".channels='1-11'
			[ -z "$(uci -q get wireless."$sec".acs_chan_bias)" ] && \
				uci set wireless."$sec".acs_chan_bias='1:0.6 6:0.6 11:0.6'
			if ! uci -q show wireless."$sec".hostapd_options | grep -qE "(^|[' ])acs_num_scans="; then
				uci add_list wireless."$sec".hostapd_options='acs_num_scans=2'
			fi
		elif [ "$band" = "5g" ]; then
			[ -z "$(uci -q get wireless."$sec".acs_exclude_dfs)" ] && \
				uci set wireless."$sec".acs_exclude_dfs='1'
			if ! uci -q show wireless."$sec".hostapd_options | grep -qE "(^|[' ])acs_num_scans="; then
				uci add_list wireless."$sec".hostapd_options='acs_num_scans=1'
			fi
			# min_tx_power=15 skips EU 25 mW (13 dBm) channels 149-173; MT7915 cap is 27 dBm, PA/RU/UA/BY/KZ/US >= 20 dBm.
			if [ -z "$(uci -q get wireless."$sec".min_tx_power)" ] && \
			   ! uci -q show wireless."$sec".hostapd_options | grep -qE "(^|[' ])min_tx_power="; then
				uci add_list wireless."$sec".hostapd_options='min_tx_power=15'
			fi
		fi
	done
	uci -q commit wireless
	touch /etc/config/ax3200
	uci set ax3200.defaults='defaults'
	uci set ax3200.defaults.acs='1'
	uci -q commit ax3200
fi

[ "$(uci -q get ax3200.defaults.applied)" = "1" ] && exit 0

# Footstrap as the default LuCI theme instead of the stock Bootstrap
if [ "$(uci -q get luci.main.mediaurlbase)" = "/luci-static/bootstrap" ] && theme_ok /luci-static/footstrap; then
	uci set luci.main.mediaurlbase='/luci-static/footstrap'
	uci -q commit luci
fi

# Enable Hardware Flow Offloading (MediaTek PPE + WED)
uci set firewall.@defaults[0].flow_offloading='1'
uci set firewall.@defaults[0].flow_offloading_hw='1'

# Drop invalid conntrack packets
[ -z "$(uci -q get firewall.@defaults[0].drop_invalid)" ] && uci set firewall.@defaults[0].drop_invalid='1'

# Stealth firewall: DROP instead of REJECT for input/forward (only if still at the stock REJECT value)
for opt in input forward; do
	[ "$(uci -q get firewall.@defaults[0].$opt)" = "REJECT" ] && uci set firewall.@defaults[0].$opt='DROP'
done
zidx=0
while uci -q get firewall.@zone[$zidx] >/dev/null; do
	if [ "$(uci -q get firewall.@zone[$zidx].name)" = "wan" ]; then
		for opt in input forward; do
			[ "$(uci -q get firewall.@zone[$zidx].$opt)" = "REJECT" ] && uci set firewall.@zone[$zidx].$opt='DROP'
		done
	fi
	zidx=$((zidx + 1))
done
uci -q commit firewall

# SSH only on the LAN interface (defense in depth on top of the DROP policy on WAN)
if uci -q get dropbear.@dropbear[0] >/dev/null; then
	[ -z "$(uci -q get dropbear.@dropbear[0].Interface)" ] && uci set dropbear.@dropbear[0].Interface='lan'
	uci -q commit dropbear
fi

# Enable CPU frequency, conntrack, hardware sensors and thermal graphs (collectd) and track the WAN interface
if [ -f /etc/config/luci_statistics ]; then
	for plugin in cpufreq conntrack sensors thermal; do
		[ "$(uci -q get luci_statistics.collectd_$plugin.enable)" = "0" ] && uci set luci_statistics.collectd_$plugin.enable='1'
	done
	[ "$(uci -q get luci_statistics.collectd_interface.Interfaces)" = "br-lan" ] && uci set luci_statistics.collectd_interface.Interfaces='br-lan wan'
	uci -q commit luci_statistics
fi

# Enable packet steering, mode 2: pins threaded NAPI (mtk_eth, mt76) to CPUs, spreads RPS over both
# CPUs and sets up RFS with 128 flows (the balanced operating mode, see luci-app-tuning)
uci set network.globals.packet_steering='2'
uci set network.globals.steering_flows='128'
uci -q commit network

# Set ZRAM size and compression algorithm to lz4 (lowest latency for Cortex-A53)
uci set system.@system[0].zram_size_mb='120'
uci set system.@system[0].zram_comp_algo='lz4'

# Configure procd service respawn defaults (infinite retry on crash loop)
if ! uci -q get system.@service[0] >/dev/null; then
	uci add system service >/dev/null
fi
uci set system.@service[0].respawn_threshold='3600'
uci set system.@service[0].respawn_timeout='5'
uci set system.@service[0].respawn_retry='0'
uci -q commit system

# Configure https-dns-proxy integration with dnsmasq. Do not force clients to the
# router's DNS: force_dns also rejects DoT (853), which breaks Android Private DNS.
if uci -q get https-dns-proxy.config >/dev/null; then
	uci set https-dns-proxy.config.dnsmasq_config_update='*'
	uci set https-dns-proxy.config.force_dns='0'
	uci set https-dns-proxy.config.conn_loss_time='30'
	uci -q commit https-dns-proxy
fi

# Dynamic DNS ships with example services only: do not start it at boot while no service is
# enabled. LuCI -> Services -> Dynamic DNS -> "Start DDNS" turns the autostart on again.
if [ -x /etc/init.d/ddns ] && ! uci -q show ddns | grep -q "\.enabled='1'$"; then
	/etc/init.d/ddns disable
fi

# Remember that the defaults have been applied to this configuration
touch /etc/config/ax3200
uci set ax3200.defaults='defaults'
uci set ax3200.defaults.applied='1'
uci -q commit ax3200

exit 0
