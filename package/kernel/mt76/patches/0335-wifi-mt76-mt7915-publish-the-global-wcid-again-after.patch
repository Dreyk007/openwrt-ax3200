From de22bbe17a626cc36c3f6d9748a61a306bb3dbfc Mon Sep 17 00:00:00 2001
From: Felix Fietkau <nbd@nbd.name>
Date: Thu, 19 Nov 2026 13:43:46 +0100
Subject: [PATCH 335/345] wifi: mt76: mt7915: publish the global wcid again
 after a full reset

After a full reset, dev->wcid[] no longer holds the global wcid.
mt76_reset_device() unpublishes it with every other wcid, and
mt7915_mac_full_reset() only allocates its index again. A frame on the
global wcid that requests a TX status then reports no ACK, since
mt76_tx_status_skb_add() does not find the wcid in dev->wcid[].

Set up the global wcid in the full reset as at probe time.

Fixes: 065c79df595a ("wifi: mt76: mt7915: fix list corruption after hardware restart")
Link: https://patch.msgid.link/20261119124352.1842164-14-nbd@nbd.name
Signed-off-by: Felix Fietkau <nbd@nbd.name>
(cherry picked from commit de22bbe17a626cc36c3f6d9748a61a306bb3dbfc)
---
 mt7915/init.c   | 29 +++++++++++++++++------------
 mt7915/mac.c    |  3 +--
 mt7915/mt7915.h |  1 +
 3 files changed, 19 insertions(+), 14 deletions(-)

diff --git a/mt7915/init.c b/mt7915/init.c
index acf621a1..1a9681b1 100644
--- a/mt7915/init.c
+++ b/mt7915/init.c
@@ -827,10 +827,25 @@ static bool mt7915_band_config(struct mt7915_dev *dev)
 	return ret;
 }
 
+int mt7915_global_wcid_init(struct mt7915_dev *dev)
+{
+	int idx = mt76_wcid_alloc(dev->mt76.wcid_mask, MT7915_WTBL_STA);
+
+	if (idx)
+		return -ENOSPC;
+
+	dev->mt76.global_wcid.idx = idx;
+	dev->mt76.global_wcid.hw_key_idx = -1;
+	dev->mt76.global_wcid.tx_info |= MT_WCID_TX_INFO_SET;
+	rcu_assign_pointer(dev->mt76.wcid[idx], &dev->mt76.global_wcid);
+
+	return 0;
+}
+
 static int
 mt7915_init_hardware(struct mt7915_dev *dev, struct mt7915_phy *phy2)
 {
-	int ret, idx;
+	int ret;
 
 	mt76_wr(dev, MT_INT_MASK_CSR, 0);
 	mt76_wr(dev, MT_INT_SOURCE_CSR, ~0);
@@ -857,17 +872,7 @@ mt7915_init_hardware(struct mt7915_dev *dev, struct mt7915_phy *phy2)
 			return ret;
 	}
 
-	/* Beacon and mgmt frames should occupy wcid 0 */
-	idx = mt76_wcid_alloc(dev->mt76.wcid_mask, MT7915_WTBL_STA);
-	if (idx)
-		return -ENOSPC;
-
-	dev->mt76.global_wcid.idx = idx;
-	dev->mt76.global_wcid.hw_key_idx = -1;
-	dev->mt76.global_wcid.tx_info |= MT_WCID_TX_INFO_SET;
-	rcu_assign_pointer(dev->mt76.wcid[idx], &dev->mt76.global_wcid);
-
-	return 0;
+	return mt7915_global_wcid_init(dev);
 }
 
 void mt7915_set_stream_vht_txbf_caps(struct mt7915_phy *phy)
diff --git a/mt7915/mac.c b/mt7915/mac.c
index b202af84..c352039c 100644
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -1476,8 +1476,7 @@ mt7915_mac_full_reset(struct mt7915_dev *dev)
 	dev->twt.table_mask = 0;
 	dev->twt.n_agrt = 0;
 
-	i = mt76_wcid_alloc(dev->mt76.wcid_mask, MT7915_WTBL_STA);
-	dev->mt76.global_wcid.idx = i;
+	mt7915_global_wcid_init(dev);
 	dev->recovery.hw_full_reset = false;
 
 	mutex_unlock(&dev->mt76.mutex);
diff --git a/mt7915/mt7915.h b/mt7915/mt7915.h
index 4123933d..26e83d27 100644
--- a/mt7915/mt7915.h
+++ b/mt7915/mt7915.h
@@ -453,6 +453,7 @@ u32 mt7915_wed_init_buf(void *ptr, dma_addr_t phys, int token_id);
 
 int mt7915_register_device(struct mt7915_dev *dev);
 void mt7915_unregister_device(struct mt7915_dev *dev);
+int mt7915_global_wcid_init(struct mt7915_dev *dev);
 int mt7915_eeprom_init(struct mt7915_dev *dev);
 void mt7915_eeprom_parse_hw_cap(struct mt7915_dev *dev,
 				struct mt7915_phy *phy);
-- 
