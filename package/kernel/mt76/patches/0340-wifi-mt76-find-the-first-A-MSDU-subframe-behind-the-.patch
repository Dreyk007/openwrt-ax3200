From 6145ff0b02f315f8e80af01345cb3bd6caa62b84 Mon Sep 17 00:00:00 2001
From: Felix Fietkau <nbd@nbd.name>
Date: Tue, 17 Nov 2026 19:01:24 +0100
Subject: [PATCH 340/344] wifi: mt76: find the first A-MSDU subframe behind the
 radiotap data

mt76_rx_release_amsdu() reads the first subframe relative to
skb->data, which points to the radiotap data where the driver pushed HE
fields or EHT TLVs. It then misses an RFC1042 header in place of the
destination address, so an A-MSDU of an HE or EHT PPDU in 802.11 format
passes the mitigation of CVE-2020-24588.

Locate the subframe behind the header that mt76_skb_get_hdr() returns.

Fixes: 2c2bdd2372af ("mt76: validate rx A-MSDU subframes")
Reviewed-by: Lorenzo Bianconi <lorenzo@kernel.org>
Link: https://patch.msgid.link/20261117180134.2940930-9-nbd@nbd.name
Signed-off-by: Felix Fietkau <nbd@nbd.name>
(cherry picked from commit 6145ff0b02f315f8e80af01345cb3bd6caa62b84)
---
 mac80211.c | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/mac80211.c b/mac80211.c
index 6e792433..ff3bd685 100644
--- a/mac80211.c
+++ b/mac80211.c
@@ -971,18 +971,21 @@ static void mt76_rx_release_amsdu(struct mt76_phy *phy, enum mt76_rxq_id q)
 	 * address.
 	 */
 	if (skb_shinfo(skb)->frag_list) {
-		int offset = 0;
+		u8 *subframe = skb->data;
 
 		if (!(status->flag & RX_FLAG_8023)) {
-			offset = ieee80211_get_hdrlen_from_skb(skb);
+			struct ieee80211_hdr *hdr = mt76_skb_get_hdr(skb);
+
+			subframe = (u8 *)hdr +
+				   ieee80211_hdrlen(hdr->frame_control);
 
 			if ((status->flag &
 			     (RX_FLAG_DECRYPTED | RX_FLAG_IV_STRIPPED)) ==
 			    RX_FLAG_DECRYPTED)
-				offset += 8;
+				subframe += 8;
 		}
 
-		if (ether_addr_equal(skb->data + offset, rfc1042_header)) {
+		if (ether_addr_equal(subframe, rfc1042_header)) {
 			dev_kfree_skb(skb);
 			return;
 		}
