 	conf->acs_ch_list.num = 0;
 #ifdef CONFIG_ACS
 	conf->acs_num_scans = 5;
+	conf->acs_scan_duration = 0;
 #endif /* CONFIG_ACS */
 
 #ifdef CONFIG_IEEE80211AX
