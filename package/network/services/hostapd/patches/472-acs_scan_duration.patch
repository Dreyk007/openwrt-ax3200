Index: hostapd-2025.08.26~ca266cc2/src/drivers/driver.h
===================================================================
--- hostapd-2025.08.26~ca266cc2.orig/src/drivers/driver.h
+++ hostapd-2025.08.26~ca266cc2/src/drivers/driver.h
@@ -668,6 +668,15 @@ struct wpa_driver_scan_params {
 	  */
 	 unsigned int duration_mandatory:1;
 
+	 /**
+	  * duration_advisory - Send duration even without SET_SCAN_DWELL
+	  *
+	  * Used by ACS when duration is non-mandatory, so software-scan
+	  * mac80211 drivers that honour NL80211_ATTR_MEASUREMENT_DURATION
+	  * without advertising NL80211_EXT_FEATURE_SET_SCAN_DWELL receive it.
+	  */
+	 unsigned int duration_advisory:1;
+
 	/**
 	 * relative_rssi_set - Whether relative RSSI parameters are set
 	 */
Index: hostapd-2025.08.26~ca266cc2/src/drivers/driver_nl80211_scan.c
===================================================================
--- hostapd-2025.08.26~ca266cc2.orig/src/drivers/driver_nl80211_scan.c
+++ hostapd-2025.08.26~ca266cc2/src/drivers/driver_nl80211_scan.c
@@ -306,8 +306,9 @@ nl80211_scan_common(struct i802_bss *bss
 	}
 
 	if (params->duration) {
-		if (!(drv->capa.rrm_flags &
-		      WPA_DRIVER_FLAGS_SUPPORT_SET_SCAN_DWELL) ||
+		if ((!(drv->capa.rrm_flags &
+		       WPA_DRIVER_FLAGS_SUPPORT_SET_SCAN_DWELL) &&
+		     (!params->duration_advisory || params->duration_mandatory)) ||
 		    nla_put_u16(msg, NL80211_ATTR_MEASUREMENT_DURATION,
 				params->duration))
 			goto fail;
