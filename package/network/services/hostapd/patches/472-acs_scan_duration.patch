===================================================================
--- hostapd-2025.08.26~ca266cc2.orig/hostapd/config_file.c
+++ hostapd-2025.08.26~ca266cc2/hostapd/config_file.c
@@ -3264,6 +3264,14 @@ static int hostapd_config_fill(struct ho
 			return 1;
 		}
 		conf->acs_num_scans = val;
+	} else if (os_strcmp(buf, "acs_scan_duration") == 0) {
+		int val = atoi(pos);
+		if (val < 0 || val > 1000) {
+			wpa_printf(MSG_ERROR, "Line %d: invalid acs_scan_duration %d (expected 0..1000)",
+				   line, val);
+			return 1;
+		}
+		conf->acs_scan_duration = val;
 	} else if (os_strcmp(buf, "acs_chan_bias") == 0) {
 		if (hostapd_config_parse_acs_chan_bias(conf, pos)) {
 			wpa_printf(MSG_ERROR, "Line %d: invalid acs_chan_bias",
Index: hostapd-2025.08.26~ca266cc2/hostapd/hostapd.conf
===================================================================
--- hostapd-2025.08.26~ca266cc2.orig/hostapd/hostapd.conf
+++ hostapd-2025.08.26~ca266cc2/hostapd/hostapd.conf
@@ -183,6 +183,14 @@ channel=1
 # interference that may help choosing a better channel. This can also help fine
 # tune the ACS scan time in case a driver has different scan dwell times.
 #
+# acs_scan_duration requirement is 0..1000 - dwell time per channel in ms for
+# each ACS scan (0 leaves the driver default unchanged). mac80211 software scan
+# drivers treat the duration as a minimum dwell time: values below 110 ms (at
+# HZ=100) keep the 110 ms default passive dwell.
+#
+# Default:
+#acs_scan_duration=0
+#
 # acs_chan_bias is a space-separated list of <channel>:<bias> pairs. It can be
 # used to increase (or decrease) the likelihood of a specific channel to be
 # selected by the ACS algorithm. The total interference factor for each channel
Index: hostapd-2025.08.26~ca266cc2/src/ap/acs.c
===================================================================
--- hostapd-2025.08.26~ca266cc2.orig/src/ap/acs.c
+++ hostapd-2025.08.26~ca266cc2/src/ap/acs.c
@@ -1520,6 +1520,19 @@ static int acs_request_scan(struct hosta
 			   iface->acs_num_completed_scans + 1,
 			   iface->conf->acs_num_scans);
 
+	if (iface->conf->acs_scan_duration) {
+		/*
+		 * NL80211_ATTR_MEASUREMENT_DURATION is in TUs (1024 us), while
+		 * mac80211 software scan passes duration to msecs_to_jiffies().
+		 * Rounding ms to TUs obeys nl80211 and gives exact 200/300/400 ms
+		 * at HZ=100 (e.g. 300 ms -> 293 TU -> 30 jiffies).
+		 */
+		params.duration = (iface->conf->acs_scan_duration * 1000 + 512) / 1024;
+		if (!params.duration)
+			params.duration = 1;
+		params.duration_advisory = 1;
+	}
+
 	ret = hostapd_driver_scan(iface->bss[0], &params);
 	os_free(params.freqs);
 
