From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felix Fietkau <nbd@nbd.name>
Date: Wed, 28 Oct 2026 09:33:50 +0100
Subject: [PATCH 4/6] main: only use prctl() on linux

Fixes build error on non-Linux systems (for dummy mode)

Signed-off-by: Felix Fietkau <nbd@nbd.name>
(cherry picked from commit 1816971a93c35a05bddb577ddbedd61ce0873a18)
---
 main.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/main.c b/main.c
index 8c1bf1d..cde0442 100644
--- a/main.c
+++ b/main.c
@@ -20,7 +20,9 @@
 #include <syslog.h>
 #include <errno.h>
 #include <unistd.h>
+#ifdef linux
 #include <sys/prctl.h>
+#endif
 
 #include "netifd.h"
 #include "ubus.h"
@@ -230,7 +232,9 @@ netifd_start_process(const char **argv, char **env, struct netifd_process *proc)
 		 * helpers again, so a helper of the dead one must end with it.
 		 */
 		signal(SIGTERM, SIG_DFL);
+#ifdef linux
 		prctl(PR_SET_PDEATHSIG, SIGTERM);
+#endif
 		if (getppid() != parent)
 			_exit(127);
 
