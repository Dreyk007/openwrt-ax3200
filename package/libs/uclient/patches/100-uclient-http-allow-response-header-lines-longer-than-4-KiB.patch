From 6b266d20c788ceeabb3641233037c8fd9a0f7d60 Mon Sep 17 00:00:00 2001
From: Valentin Berezhnoy <dreyksmail@gmail.com>
Date: Sat, 14 Nov 2026 21:39:39 +0200
Subject: [PATCH] uclient-http: allow response header lines longer than 4 KiB

A response header line is parsed once it is complete in the read
buffer. The stream has a single read buffer of the ustream default
size, 4 KiB, so a longer line fills it, reading stops, and the request
waits until it times out.

github.com now sends a Content-Security-Policy line of 4174 bytes, also
with the redirects of archive and release downloads, so uclient-fetch
can no longer download anything from github.com:

  $ uclient-fetch https://github.com/openwrt/uclient/archive/refs/heads/master.tar.gz
  Downloading 'https://github.com/openwrt/uclient/archive/refs/heads/master.tar.gz'
  Connecting to 140.82.121.4:443
  Connection error: Connection timed out

Use a 32 KiB read buffer. For comparison, curl accepts header lines of
up to 100 KiB and Python's http.client up to 64 KiB.

Assisted-by: LLM
Signed-off-by: Valentin Berezhnoy <dreyksmail@gmail.com>
Link: https://github.com/openwrt/uclient/pull/22
---
 uclient-http.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/uclient-http.c b/uclient-http.c
index 04ddcb9..9d421d6 100644
--- a/uclient-http.c
+++ b/uclient-http.c
@@ -34,6 +34,14 @@
 #include "uclient-utils.h"
 #include "uclient-backend.h"
 
+/*
+ * A response header line is parsed once it is complete in the read buffer,
+ * so the buffer limits the length of a header line. The ustream default of
+ * 4 KiB is too small: github.com sends a Content-Security-Policy longer than
+ * that.
+ */
+#define HTTP_READ_BUF_LEN	(32 * 1024)
+
 enum auth_type {
 	AUTH_TYPE_UNKNOWN,
 	AUTH_TYPE_NONE,
@@ -933,6 +941,7 @@ static int uclient_setup_http(struct uclient_http *uh)
 	uh->ssl = false;
 
 	us->string_data = true;
+	us->r.buffer_len = HTTP_READ_BUF_LEN;
 	us->notify_state = uclient_notify_state;
 	us->notify_read = uclient_notify_read;
 	us->notify_write = uclient_notify_write;
@@ -1019,6 +1028,7 @@ static int uclient_setup_https(struct uclient_http *uh)
 		return UCLIENT_ERROR_CONNECT;
 
 	us->string_data = true;
+	us->r.buffer_len = HTTP_READ_BUF_LEN;
 	us->notify_state = uclient_ssl_notify_state;
 	us->notify_read = uclient_ssl_notify_read;
 	us->notify_write = uclient_ssl_notify_write;
-- 
